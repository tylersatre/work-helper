# Password MCP clients enter on the connector password page. Required — `docker compose up` refuses to start without it.
CONNECTOR_PASSWORD=

# Host port the stack publishes for direct (non-Caddy) access. Optional — defaults to 8080 if unset.
WORK_HELPER_PORT=8080

# Entra ID app registration client id (public client, delegated Mail.Read + offline_access,
# device-code flow enabled). Optional — email sync (the sync-emails MCP tool) is disabled
# until this is set and `npm run mail:signin` has been run. See docs/deploy.md.
MS_CLIENT_ID=
