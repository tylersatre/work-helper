# Token-signing key material for MCP access tokens. Required — `docker compose up` refuses to
# start without it. Rotate this value to revoke every connected MCP client at once.
MCP_TOKEN_SECRET=

# The deployment's Authentik userinfo endpoint, reachable from the app container — e.g.
# http://<authentik-server-container>:9000/application/o/userinfo/ on the shared work-helper
# Docker network. Required — used to verify that an MCP connect request genuinely originated
# from this Authentik instance's sign-in flow. See docs/deploy.md.
AUTHENTIK_USERINFO_URL=

# Host port the stack publishes for direct (non-Caddy) access. Optional — defaults to 8080 if unset.
WORK_HELPER_PORT=8080

# Entra ID app registration client id (public client, delegated Mail.Read + offline_access,
# device-code flow enabled). Optional — email sync (the sync-emails MCP tool) is disabled
# until this is set and `npm run mail:signin` has been run. See docs/deploy.md.
MS_CLIENT_ID=

# The app registration's Directory (tenant) ID, from the same Overview page as MS_CLIENT_ID.
# Required whenever MS_CLIENT_ID is set — sign-in targets this tenant directly, because
# single-tenant registrations are rejected at the /common authority (AADSTS50059).
MS_TENANT_ID=
