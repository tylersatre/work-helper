{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(npx *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "feature-dev:feature-dev": "off"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "feature-dev@claude-code-plugins": false,
    "superpowers@superpowers-dev": false,
    "ralph-wiggum@claude-code-plugins": false,
    "feature-dev@claude-plugins-official": false,
    "plugin-dev@claude-code-plugins": false,
    "vue-ts-lsp@vue-ts-lsp": false,
    "php-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "phpstorm-plugin@phpstorm-marketplace": false,
    "planning-with-teams@planning-with-teams": false,
    "query@contextify": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  }
}
